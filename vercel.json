{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
      "src": "invite.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/invite",
      "dest": "/invite.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/index.js"
    }
  ]
}
